{
  "type": "object",
  "properties": {
    "documentType": {
      "type": "string",
      "enum": ["SUPPLIER_INVOICE", "CUSTOMER_INVOICE", "CREDIT_NOTE", "CMR", "CONTRACT", "OTHER"]
    },
    "summary": { "type": "string" },
    "documentNumber": { "type": "string" },
    "issueDate": { "type": "string" },
    "taxableDate": { "type": "string" },
    "dueDate": { "type": "string" },
    "currency": { "type": "string" },
    "variableSymbol": { "type": "string" },
    "issuer": { "$ref": "#/$defs/party" },
    "recipient": { "$ref": "#/$defs/party" },
    "netAmount": { "type": "string" },
    "vatAmount": { "type": "string" },
    "totalAmount": { "type": "string" },
    "vatNote": { "type": "string" },
    "references": { "type": "string" },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "quantity": { "type": "string" },
          "unit": { "type": "string" },
          "unitPrice": { "type": "string" },
          "total": { "type": "string" },
          "vatRate": { "type": "string" }
        },
        "required": ["description", "quantity", "unit", "unitPrice", "total", "vatRate"],
        "additionalProperties": false
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["documentType", "summary", "documentNumber", "issueDate", "taxableDate", "dueDate", "currency",
    "variableSymbol", "issuer", "recipient", "netAmount", "vatAmount", "totalAmount", "vatNote", "references", "lines",
    "warnings"],
  "additionalProperties": false,
  "$defs": {
    "party": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "companyId": { "type": "string" },
        "vatNumber": { "type": "string" },
        "address": { "type": "string" },
        "country": { "type": "string" },
        "bankAccount": { "type": "string" }
      },
      "required": ["name", "companyId", "vatNumber", "address", "country", "bankAccount"],
      "additionalProperties": false
    }
  }
}
